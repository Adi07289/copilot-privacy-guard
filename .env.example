# Copy to .env. Without GROQ_API_KEY the prototype runs offline (extractive answers; committed caches replay LLM results).
GROQ_API_KEY=
LLM_PROVIDER=groq            # groq | extractive  (groq auto-falls back to extractive on any error)
GROQ_MODEL=qwen/qwen3.8-27b              # answer model
GROQ_JUDGE_MODEL=openai/gpt-oss-120b     # LLM-as-judge for injection screening
GROQ_PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m   # comparator in the injection benchmark
